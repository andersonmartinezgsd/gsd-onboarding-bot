# =============================================================================
# GSD Onboarding/Offboarding — Unified Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# =============================================================================

# =============================================================================
# SLACK
# =============================================================================
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here
USE_SOCKET_MODE=true

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
BOT_LANGUAGE=en
COMPANY_NAME=GSD
COMPANY_EMAIL_DOMAIN=gsdoutsources.com

# =============================================================================
# DATABASE (slack-bot)
# =============================================================================
DB_TYPE=sqlite
DB_PATH=/app/storage/db/onboarding.sqlite

# MySQL — uncomment and fill if DB_TYPE=mysql
# DB_TYPE=mysql
# MYSQL_HOST=your-mysql-host
# MYSQL_PORT=3306
# MYSQL_USER=dbuser
# MYSQL_PASSWORD=dbpassword
# MYSQL_DATABASE=onboarding

# =============================================================================
# HUB (PHP dashboard)
# =============================================================================
HUB_APP_URL=http://localhost:8081
HUB_APP_DEBUG=false
HUB_DB_DRIVER=sqlite
HUB_DB_SQLITE_PATH=/var/www/html/storage/db/amr_hub.sqlite

# MySQL for Hub — uncomment if needed
# HUB_DB_DRIVER=mysql
# HUB_DB_HOST=your-mysql-host
# HUB_DB_PORT=3306
# HUB_DB_NAME=amr_hub
# HUB_DB_USER=dbuser
# HUB_DB_PASSWORD=dbpassword

# =============================================================================
# GOOGLE WORKSPACE
# =============================================================================
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----\n"
GOOGLE_ADMIN_EMAIL=admin@gsdoutsources.com
GOOGLE_DOMAIN=gsdoutsources.com
GOOGLE_CUSTOMER_ID=C0abcde12
GOOGLE_ONBOARDING_DRIVE_FOLDER_ID=0AFXARejfds2BUk9PVA

# Workspace license SKU (leave empty to skip auto-assign)
# Business Starter: 1010020028 | Standard: 1010020025 | Plus: 1010020026
GOOGLE_WORKSPACE_SKU_ID=1010020028

# Delay (ms) between account creation and license assignment (Google propagation)
GOOGLE_LICENSE_DELAY_MS=5000

# =============================================================================
# GITHUB
# =============================================================================
# GITHUB_TOKEN=ghp_your-token
# GITHUB_ORG=your-org-slug

# =============================================================================
# SLACK NOTIFICATION CHANNELS
# =============================================================================
HR_CHANNEL_ID=C0HR000000
IT_CHANNEL_ID=C0IT000000
FINANCE_CHANNEL_ID=C0FIN00000
ACCOUNT_MANAGER_CHANNEL_ID=C0AM000000

# =============================================================================
# TIME DOCTOR
# =============================================================================
# TIMEDOCTOR_ACCESS_TOKEN=your-token
# TIMEDOCTOR_COMPANY_ID=123456

# =============================================================================
# SCALEFUSION MDM
# =============================================================================
# SCALEFUSION_API_KEY=your-api-key

# =============================================================================
# HUBSPOT
# =============================================================================
# HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx

# =============================================================================
# BUK HR PLATFORM
# =============================================================================
# BUK_API_URL=https://app.buk.cl
# BUK_API_TOKEN=your-buk-token
# BUK_COMPANY_SLUG=your-company-slug

# =============================================================================
# CLIENT DATA SOURCE
# =============================================================================
CLIENT_DATA_SOURCE=db
# CLIENT_API_URL=https://your-api.example.com/clients
# CLIENT_API_TOKEN=your-api-token

# =============================================================================
# VENDOR (equipment quotes)
# =============================================================================
# VENDOR_CHANNEL_ID=C0VENDOR00
# VENDOR_EMAIL=vendor@example.com

# =============================================================================
# ACCESS CONTROL
# Comma-separated Slack user IDs allowed to run /onboard, /offboard, /resetpassword
# Leave empty to allow all users
# =============================================================================
# AUTHORIZED_USER_IDS=U0HR001,U0HR002,U0ADMIN
# AUTHORIZED_CHANNEL_ID=C0HRPEOPLE

# =============================================================================
# EXTERNAL WEBHOOKS
# =============================================================================
# HUB_WEBHOOK_URL=https://your-n8n.example.com/webhook/slack
# HUB_WEBHOOK_SECRET=your-secret
