# ── Credentials / secrets (NEVER commit) ────────────────────
.env
.env.local
.env.production
hub/.env
slack-bot/.env

# ── Hub config (contains secrets) ───────────────────────────
hub/config/config.php

# ── SQLite databases ─────────────────────────────────────────
*.sqlite
*.sqlite-wal
*.sqlite-shm
hub/storage/db/
slack-bot/storage/db/

# ── Logs ────────────────────────────────────────────────────
*.log
hub/storage/logs/
slack-bot/storage/logs/

# ── Node ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
slack-bot/node_modules/

# ── PHP ──────────────────────────────────────────────────────
vendor/
hub/vendor/
hub/storage/cache/*
!hub/storage/cache/.gitkeep

# ── Uploads (user content) ───────────────────────────────────
hub/storage/uploads/*
!hub/storage/uploads/.gitkeep

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# ── IDE / AI tools ───────────────────────────────────────────
.idea/
.vscode/
.cursor/
.claude/
.aider*
*.swp
*.swo

# ── Docker build artifacts ───────────────────────────────────
*.tar
