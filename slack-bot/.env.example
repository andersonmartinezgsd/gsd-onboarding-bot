# =============================================================================
# Slack Configuration
# =============================================================================
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here   # requerido en Socket Mode
USE_SOCKET_MODE=true

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# =============================================================================
# Company defaults
# =============================================================================
COMPANY_NAME=GSD
COMPANY_EMAIL_DOMAIN=gsdoutsources.com

# =============================================================================
# Database
# =============================================================================
DB_TYPE=sqlite         # sqlite | mysql
DB_PATH=./storage/db/onboarding.sqlite

# MySQL (requerido si DB_TYPE=mysql)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=dbuser
# MYSQL_PASSWORD=dbpassword
# MYSQL_DATABASE=onboarding

# =============================================================================
# Google Workspace Integration
# =============================================================================
# Service account con domain-wide delegation
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"
GOOGLE_ADMIN_EMAIL=admin@gsdoutsources.com
GOOGLE_DOMAIN=gsdoutsources.com

# Customer ID — requerido para asignar licencias (Google Admin → Account → Settings)
# GOOGLE_CUSTOMER_ID=C0abcde12

# Parent folder ID para carpetas de onboarding (ID extraído de la URL del Drive)
# URL: https://drive.google.com/drive/u/0/folders/0AFXARejfds2BUk9PVA
# ID:  0AFXARejfds2BUk9PVA
GOOGLE_ONBOARDING_DRIVE_FOLDER_ID=0AFXARejfds2BUk9PVA

# SKU de licencia Workspace a asignar tras crear la cuenta
# Business Starter : 1010020028
# Business Standard: 1010020025
# Business Plus    : 1010020026
# Enterprise Std   : 1010020027
# (dejar vacío para no asignar licencia automáticamente)
# GOOGLE_WORKSPACE_SKU_ID=1010020028

# Milisegundos de espera entre creación de cuenta y asignación de licencias.
# Google tarda unos segundos en propagar usuarios nuevos a la Licensing API.
# Aumentar a 10000 si sigues viendo errores 404 en la asignación.
GOOGLE_LICENSE_DELAY_MS=5000

# =============================================================================
# GitHub Integration
# =============================================================================
# GITHUB_TOKEN=ghp_your-github-token
# GITHUB_ORG=your-org-slug

# =============================================================================
# Slack Notification Channels
# =============================================================================
HR_CHANNEL_ID=C0HR000000
IT_CHANNEL_ID=C0IT000000
FINANCE_CHANNEL_ID=C0FIN00000
ACCOUNT_MANAGER_CHANNEL_ID=C0AM000000

# =============================================================================
# Vendor (for equipment quotes when no inventory)
# =============================================================================
# VENDOR_CHANNEL_ID=C0VENDOR00   # Slack channel para notificar al proveedor
# VENDOR_EMAIL=proveedor@example.com

# =============================================================================
# Time Doctor Integration
# =============================================================================
# TIMEDOCTOR_ACCESS_TOKEN=your-timedoctor-token
# TIMEDOCTOR_COMPANY_ID=123456

# =============================================================================
# ScaleFusion MDM
# =============================================================================
# SCALEFUSION_API_KEY=your-scalefusion-api-key

# =============================================================================
# HubSpot
# =============================================================================
# HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx

# =============================================================================
# BUK HR Platform
# =============================================================================
# BUK_API_URL=https://app.buk.cl
# BUK_API_TOKEN=your-buk-api-token
# BUK_COMPANY_SLUG=your-company-slug   # visible en la URL de BUK

# =============================================================================
# Client Data Source
# Controla de dónde se obtiene la lista de clientes en el modal
# =============================================================================
CLIENT_DATA_SOURCE=db        # db | hubspot | api
# CLIENT_API_URL=https://your-api.example.com/clients
# CLIENT_API_TOKEN=your-api-token

# =============================================================================
# Access Control
# =============================================================================
# AUTHORIZED_USER_IDS=U0HR001,U0HR002,U0ADMIN
# AUTHORIZED_CHANNEL_ID=C0HRPEOPLE

# =============================================================================
# External Webhooks (n8n, Zapier, etc.)
# =============================================================================
# HUB_WEBHOOK_URL=http://localhost:8080/api/v1/webhooks/slack
# HUB_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# Bot Language
# =============================================================================
BOT_LANGUAGE=es
