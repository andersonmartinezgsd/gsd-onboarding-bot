{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "GSD HR Bot",
    "description": "Automatiza el onboarding y offboarding de empleados — GSD Outsources",
    "background_color": "#4A154B",
    "long_description": "Bot para gestionar el ciclo de vida de empleados: provisiona Google Workspace, Slack, Time Doctor, HubSpot y GitHub automáticamente. Usa /onboard para nuevos empleados y /offboard para salidas."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "HR Bot",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/onboard",
        "description": "Iniciar proceso de onboarding para un nuevo empleado",
        "usage_hint": "",
        "should_escape": false
      },
      {
        "command": "/offboard",
        "description": "Iniciar proceso de offboarding para un empleado que sale",
        "usage_hint": "",
        "should_escape": false
      },
      {
        "command": "/hr-status",
        "description": "Ver el estado de todos los procesos activos de HR",
        "usage_hint": "",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:manage",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "commands",
        "groups:read",
        "groups:write",
        "im:write",
        "mpim:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
